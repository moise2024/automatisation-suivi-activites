    {"name":"Resultat","label":"Résultat obtenu","type":"Number","required":false,"min":0},
    {"name":"Difficultes","label":"Difficultés rencontrées","type":"MultipleLinesOfText","required":false},
    {"name":"ProchainesEtapes","label":"Prochaines étapes","type":"MultipleLinesOfText","required":false},
    {"name":"CourrielSoumetteur","label":"Courriel du soumetteur","type":"Text","required":true,"format":"email"}
